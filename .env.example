# Anthropic API-Zugang. Ohne Key laeuft KOMPASS im Offline-Modus:
# Datenhaltung, Kapitel, Aufgaben und Lesesaal funktionieren, die Agenten antworten
# mit einem klar markierten Platzhalter statt mit erfundenem Inhalt.
ANTHROPIC_API_KEY=

# Optional: Modell-Override fuer alle Agenten (Default: claude-opus-5)
KOMPASS_MODEL=claude-opus-5

# Port der API (das Frontend proxied /api hierauf)
PORT=5177
