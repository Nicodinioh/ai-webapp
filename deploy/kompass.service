# systemd-Unit für KOMPASS.
#
#   sudo cp deploy/kompass.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now kompass
#
# Pfad zu node prüfen mit `which node` und unten anpassen, falls abweichend.

[Unit]
Description=KOMPASS - Forschungs-Betriebssystem
Documentation=https://github.com/Nicodinioh/ai-webapp
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kompass
Group=kompass
WorkingDirectory=/opt/kompass

EnvironmentFile=/opt/kompass/.env
Environment=NODE_ENV=production
Environment=PORT=5177
Environment=HOST=127.0.0.1

ExecStart=/usr/bin/node --import tsx server/index.ts

Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Härtung. Schreiben darf der Dienst nur in seinen eigenen Datenordner.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/kompass/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
