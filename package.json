{
  "name": "kompass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KOMPASS - Forschungs-Betriebssystem fuer HCAI-gestuetzte Thesisarbeit",
  "scripts": {
    "dev": "concurrently -n api,ui -c cyan,magenta \"npm:dev:api\" \"npm:dev:ui\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:ui": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "seed": "tsx server/scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.1",
    "multer": "^2.3.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=20"
  }
}
